<script>
  function swapPoints() {
    const origin = document.getElementById('origin-station');
    const dest = document.getElementById('dest-station');
    const icon = document.getElementById('swap-icon');

    const temp = origin.value;
    origin.value = dest.value;
    dest.value = temp;

    icon.classList.add('rotate-180');
    setTimeout(() => {
      icon.classList.remove('rotate-180');
    }, 300);
  }

  function setDest(destinationName) {
    document.getElementById('dest-station').value = destinationName;
  }

  function setQuery(text) {
    document.getElementById('ai-transit-query').value = text;
    applyAiPrompt(text);
  }

  function applyAiPrompt(promptText) {
    if (promptText.toLowerCase().includes('sector v')) {
      document.getElementById('dest-station').value = 'Sector V Metro Station (Salt Lake)';
    }
    if (promptText.toLowerCase().includes('serampore')) {
      document.getElementById('origin-station').value = 'Serampore Railway Station (SRP)';
    }
    if (promptText.toLowerCase().includes('sealdah')) {
      document.getElementById('origin-station').value = 'Sealdah Railway Station';
    }
    if (promptText.toLowerCase().includes('airport')) {
      document.getElementById('dest-station').value = 'Kolkata Airport (CCU)';
    }
  }

  function updateSlider(val) {
    const readout = document.getElementById('slider-readout');
    if (val == 0) {
      readout.textContent = '₹0: Lowest cost at all costs';
    } else if (val >= 100) {
      readout.textContent = '₹100+: Prioritize fastest arrival';
    } else {
      readout.textContent = `10 min saved = ₹${val}`;
    }
  }

  function toggleChip(btn) {
    const isAvoided = btn.classList.contains('bg-error-container');
    if (isAvoided) {
      btn.classList.remove('bg-error-container', 'text-error', 'font-bold');
      btn.classList.add('bg-surface-container', 'text-on-surface-variant');
      const cross = btn.querySelector('.close-icon');
      if (cross) cross.remove();
    } else {
      btn.classList.remove('bg-surface-container', 'text-on-surface-variant');
      btn.classList.add('bg-error-container', 'text-error', 'font-bold');
      const closeSpan = document.createElement('span');
      closeSpan.className = 'material-symbols-outlined text-[14px] close-icon';
      closeSpan.textContent = 'close';
      btn.appendChild(closeSpan);
    }
  }

  function toggleState(btn) {
    if (btn.classList.contains('opacity-60')) {
      btn.classList.remove('opacity-60');
    } else {
      btn.classList.add('opacity-60');
    }
  }

  function triggerRouteSearch() {
    const origin = document.getElementById('origin-station').value;
    const dest = document.getElementById('dest-station').value;
    const sliderVal = document.getElementById('time-cost-slider').value;
    
    // Highlight active route cards smoothly
    const cards = document.querySelectorAll('.lg\\:col-span-5 .bg-surface-container-low');
    cards.forEach(card => {
      card.classList.add('scale-[1.01]', 'ring-2', 'ring-secondary');
      setTimeout(() => {
        card.classList.remove('scale-[1.01]', 'ring-2', 'ring-secondary');
      }, 700);
    });
  }
